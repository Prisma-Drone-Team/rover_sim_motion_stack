<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='plant_pot'>
    <static>true</static>
    <pose>0 0 0.0 0 0 0</pose>
    <link name='base'>
      <!-- Box nero come base -->
      <visual name='box_visual'>
        <geometry>
          <box>
            <size>0.4 0.5 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Piano con texture ArUco sulla faccia superiore -->
      <visual name='texture_neg_y'>
        <pose>0 0 0.201 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.4 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://leo_race_field/plant_pot/plant_pot.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name='texture_pos_y'>
        <pose>0 0 -0.201 3.14159 0 3.14159</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.4 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://leo_race_field/plant_pot/plant_pot.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name='texture_pos_x'>
        <pose>0.201 0 0 0 1.5708 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.4 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://leo_race_field/plant_pot/plant_pot.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name='texture_neg_x'>
        <pose>-0.201 0 0 0 -1.5708 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.4 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://leo_race_field/plant_pot/plant_pot.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision geometry -->
      <collision name='box_collision'>
        <geometry>
          <box>
            <size>0.4 0.3 0.5</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
